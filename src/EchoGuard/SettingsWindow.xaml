<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{DynamicResource WindowSurface}" BorderBrush="#39475C" BorderThickness="1" CornerRadius="16" Padding="28"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="DialogHeader" Background="Transparent" Margin="0,0,0,20"><StackPanel><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="EchoGuard 1.0.0" Foreground="#9AA9C1" FontSize="13" Margin="0,5,0,0"/></StackPanel><Button x:Name="DialogCloseButton" Style="{DynamicResource IconButton}" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Close Settings"><Path Data="M0,0 L16,16 M16,0 L0,16" Stroke="#9AA9C1" StrokeThickness="1.8"/></Button></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0">
   <TextBlock Text="Audio configuration" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="SelectionText" TextWrapping="Wrap" Foreground="#9AA9C1" FontSize="15" Margin="0,10,0,15"/>
   <Border Background="{DynamicResource ElevatedSurface}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="Audio processing" Foreground="#9AA9C1" FontSize="12"/><TextBlock x:Name="ProcessingText" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="Duplicate playback source" Foreground="#9AA9C1" FontSize="12"/><TextBlock x:Name="SourceText" FontSize="15" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock x:Name="CompatibilityText" FontSize="14" Foreground="#78ADFF" TextWrapping="Wrap"/></StackPanel></Border>
   <CheckBox x:Name="RememberBox" Style="{DynamicResource BlueCheckBox}" Content="Remember My Configuration" Margin="0,18,0,16" FontSize="16"/>
   <Expander Header="Available microphones and endpoint identities" Foreground="#9AA9C1" FontSize="15"><ListBox x:Name="MicrophoneList" MaxHeight="190" Background="#111824" BorderThickness="0" Foreground="#F4F7FC" Margin="0,10,0,10" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding DisplayLabel}" FontSize="13" TextWrapping="Wrap"/><TextBlock Text="{Binding Classification}" FontSize="12" Foreground="#9AA9C1"/><TextBlock Text="{Binding Id}" FontSize="11" TextWrapping="Wrap" Foreground="#71839F"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
   <TextBlock Text="Diagnostics" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,10"/><Border Background="#111824" CornerRadius="10" Padding="12"><TextBox x:Name="DiagnosticsText" Height="155" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#9AA9C1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Border>
   <WrapPanel Margin="0,16,0,0"><Button x:Name="RestoreButton" Style="{DynamicResource SmallButton}" Content="Restore previous state" Margin="0,0,10,10"/><Button x:Name="ExportButton" Style="{DynamicResource SmallButton}" Content="Save report" Margin="0,0,10,10"/><Button x:Name="SettingsDiagnoseButton" Style="{DynamicResource SmallButton}" Content="Run diagnostics" Margin="0,0,0,10"/></WrapPanel>
   <TextBlock x:Name="ActionText" FontSize="13" Foreground="#9AA9C1" TextWrapping="Wrap" Margin="0,6,0,8"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="Offline. No recordings. No telemetry." FontSize="12" Foreground="#71839F" VerticalAlignment="Center"/><Button x:Name="ExitButton" Style="{DynamicResource SmallButton}" Content="Exit completely" HorizontalAlignment="Right"/></Grid>
 </Grid></Border>
</Grid>
