<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
 <Border x:Name="WindowOutline" Background="{DynamicResource WindowSurface}" BorderBrush="#39475C" BorderThickness="1" CornerRadius="17">
  <Grid x:Name="DesignStage">
   <Grid x:Name="PageLayout" Margin="{DynamicResource PageMargin}"><Grid.RowDefinitions><RowDefinition Height="{DynamicResource HeaderHeight}"/><RowDefinition Height="*"/><RowDefinition Height="{DynamicResource FooterHeight}"/></Grid.RowDefinitions>
    <Grid x:Name="DragHeader" Background="Transparent">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="6,1,0,0">
      <Viewbox Width="80" Height="82" Stretch="Fill" VerticalAlignment="Top" Margin="0,-1,27,0"><Canvas Width="80" Height="82">
       <Path Data="M4,26 C10,11 24,3 39,3 C55,3 69,13 73,26" Stroke="#1677FF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Path Data="M3,55 C8,69 21,78 37,78 C58,78 74,62 75,41" Stroke="#1677FF" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Path Data="M17,40 C25,40 26,32 32,28 C38,23 45,27 40,34 L33,42 C27,48 31,58 38,55 C44,53 47,40 57,40" Stroke="#6DB7FB" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
      </Canvas></Viewbox>
      <StackPanel Margin="0,-5,0,0"><TextBlock FontSize="47.5" FontWeight="Bold" LineHeight="60"><Run Text="Echo" Foreground="#F4F7FC"/><Run Text="Guard" Foreground="#1677FF"/></TextBlock><TextBlock Text="Stop Discord mic echo. Keep your audio clean." FontSize="19.65" Foreground="#9AA9C1" Margin="1,-1,0,0"/></StackPanel>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="{DynamicResource CaptionButtonsMargin}">
      <Button x:Name="SettingsButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource IconButton}" Width="70" Height="44" ToolTip="Settings" AutomationProperties.Name="Settings"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M9,2 L15,2 L15.8,5 L18,6.3 L20.8,5.5 L23,10 L20.7,12 L20.7,14.2 L23,16 L20.5,20 L17.7,19 L15.6,20.3 L15,23 L9,23 L8.4,20.3 L6.3,19 L3.5,20 L1,16 L3.3,14.2 L3.3,12 L1,10 L3.2,5.5 L6,6.3 L8.2,5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeLineJoin="Round"/><Ellipse Canvas.Left="8.5" Canvas.Top="9" Width="7" Height="7" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Canvas></Viewbox></Button>
      <Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource IconButton}" Width="70" Height="44" ToolTip="Minimize" AutomationProperties.Name="Minimize"><Path Data="M0,0 H20" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button>
      <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{DynamicResource IconButton}" Width="70" Height="44" ToolTip="Close to tray" AutomationProperties.Name="Close to tray"><Path Data="M0,0 L18,18 M18,0 L0,18" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"/></Button>
     </StackPanel>
    </Grid>
    <Border x:Name="ContentPanel" Grid.Row="1" Background="{DynamicResource PanelSurface}" BorderBrush="#2D3A50" BorderThickness="1" CornerRadius="17" Padding="{DynamicResource PanelPadding}"><ScrollViewer x:Name="PanelScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False" PanningMode="VerticalOnly">
     <Grid x:Name="PanelContent" VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="{DynamicResource SectionGap}"/><RowDefinition Height="Auto"/><RowDefinition Height="{DynamicResource ActionGap}"/><RowDefinition Height="{DynamicResource DetectHeight}"/><RowDefinition Height="{DynamicResource ButtonGap}"/><RowDefinition Height="{DynamicResource FixHeight}"/></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource IconColumn}"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Canvas Width="38" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,7,0,0"><Rectangle Canvas.Left="8" Canvas.Top="0" Width="22" Height="36" RadiusX="11" RadiusY="11" Fill="#B5C0D8"/><Path Data="M2,25 L2,30 C2,50 36,50 36,30 L36,25 M19,46 V54 M12,54 H26" Stroke="#B5C0D8" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Your Microphone" FontSize="{DynamicResource SectionFont}" FontWeight="SemiBold" Height="{DynamicResource HeadingHeight}"/><TextBlock Text="Select the microphone you use in Discord." FontSize="{DynamicResource BodyFont}" Foreground="#9AA9C1" Height="{DynamicResource BodyHeight}" Margin="{DynamicResource BodyMargin}"/><ComboBox x:Name="MicrophoneBox" Style="{DynamicResource MicrophoneChoice}" DisplayMemberPath="Label" FontSize="{DynamicResource ChoiceFont}" Height="{DynamicResource ChoiceHeight}" Margin="{DynamicResource ChoiceMargin}" AutomationProperties.Name="Your Microphone"/></StackPanel>
      </Grid>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource IconColumn}"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Canvas Width="44" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,7,0,0"><Path Data="M2,21 V31 M12,14 V38 M22,2 V50 M32,13 V39 M42,21 V31" Stroke="#A9B7D0" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas>
       <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Status" FontSize="{DynamicResource StatusHeadingFont}" FontWeight="SemiBold" Height="{DynamicResource HeadingHeight}"/><TextBlock x:Name="StatusDescription" Text="Not checked yet." FontSize="{DynamicResource StatusBodyFont}" Foreground="#9AA9C1" Height="{DynamicResource BodyHeight}" Margin="{DynamicResource BodyMargin}"/><Border Background="{DynamicResource ElevatedSurface}" BorderBrush="#2D3A50" BorderThickness="1" CornerRadius="14" MinHeight="{DynamicResource StatusHeight}" Margin="{DynamicResource StatusMargin}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="30" Height="30" Fill="#5D6B81" Stroke="#69788F" StrokeThickness="0.8" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="27,0,0,0"/><TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready to detect echo source." FontSize="{DynamicResource StatusMessageFont}" VerticalAlignment="Center" TextWrapping="Wrap"  Margin="0,0,20,6"/></Grid></Border></StackPanel>
      </Grid>
      <Button x:Name="DiagnoseButton" Grid.Row="4" Style="{DynamicResource ActionButton}" Background="{DynamicResource BlueSurface}" BorderBrush="#4499FF" AutomationProperties.Name="Detect Echo"><StackPanel Orientation="Horizontal"><Viewbox Width="34" Height="34" Margin="0,0,20,0"><Canvas Width="34" Height="34"><Ellipse Canvas.Left="1" Canvas.Top="1" Width="25" Height="25" Stroke="White" StrokeThickness="3.4"/><Path Data="M23,23 L32,32" Stroke="White" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="Detect Echo" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="FixButton" Grid.Row="6" Style="{DynamicResource ActionButton}" IsEnabled="False" AutomationProperties.Name="Fix Echo"><StackPanel Orientation="Horizontal"><Viewbox Width="30" Height="34" Margin="0,0,21,0"><Path Data="M15,1 L28,7 V17 C28,24 22,30 15,33 C8,30 2,24 2,17 V7 Z" Stroke="#A3B0C8" StrokeThickness="2.8" StrokeLineJoin="Round"/></Viewbox><TextBlock x:Name="FixLabel" Text="Fix Echo" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center"/></StackPanel></Button>
     </Grid></ScrollViewer>
    </Border>
    <Grid Grid.Row="2" Margin="{DynamicResource FooterMargin}"><CheckBox x:Name="StartupBox" Style="{DynamicResource BlueCheckBox}" Content="Start with Windows" VerticalAlignment="Top" HorizontalAlignment="Left" AutomationProperties.Name="Start with Windows"/><Button x:Name="HelpButton" Style="{DynamicResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="33" AutomationProperties.Name="Need Help?"><StackPanel Orientation="Horizontal"><Grid Width="26" Height="26" Margin="0,0,18,0"><Ellipse Stroke="#8193B1" StrokeThickness="1.8"/><TextBlock Text="?" Foreground="#9AA9C1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Grid><TextBlock Text="Need Help?" FontSize="20" Foreground="#9AA9C1" VerticalAlignment="Center"/></StackPanel></Button></Grid>
   </Grid>
  </Grid>
 </Border>
</Grid>

